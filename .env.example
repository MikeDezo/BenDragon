# Ben & Dragon! Environment Variables
# Copy this file to .env and configure your PostgreSQL database connection

# PostgreSQL Connection String (Neon, Supabase, Cloudflare Hyperdrive, Railway, Render, RDS, etc.)
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Alternatively, set individual PG connection variables:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=secret
# PGDATABASE=bendragon
